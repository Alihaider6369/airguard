# Copy this file to ".env" and edit if needed.
# Leave DATABASE_URL commented out to use the default local SQLite file.

# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///./airguard.db

# PostgreSQL (later, for production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/airguard

# Set to "true" to print every SQL statement (useful for debugging).
SQL_ECHO=false
